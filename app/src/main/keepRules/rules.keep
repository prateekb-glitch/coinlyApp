# Coinly R8 / ProGuard Keep Rules for Trust & Claim DTOs and Retrofit / Gson
-keepattributes *Annotation*, Signature, InnerClasses, EnclosingMethod

# Keep Retrofit API models / DTOs from obfuscation
-keep class com.example.coinly.trust.data.remote.** { *; }

# Keep EncryptedSharedPreferences / Security Crypto classes
-keep class androidx.security.crypto.** { *; }
